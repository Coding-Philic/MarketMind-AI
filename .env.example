# MarketMind AI — Environment Configuration
# Copy this file to backend/.env and fill in your API keys.

# Groq AI (required) — get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Tavily Web Search (required for company research) — get from https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase Database (required for cloud storage) — get from https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server
PORT=3001

# Frontend URL for production CORS (set to your Vercel URL)
# FRONTEND_URL=https://your-app.vercel.app
